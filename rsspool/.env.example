# ─── RSSHub upstream ──────────────────────────────────────────────────────────
# rsspool is a downstream of RSSHub. Point it at your (preferably self-hosted)
# RSSHub instance. Overrides the `rsshub.base` in config/feeds.json.
# RSSHUB_BASE=https://rsshub.app
# RSSHUB_ACCESS_KEY=          # if your RSSHub uses access-key auth

# ─── Storage ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the bundled SQLite store (zero setup).
# Set it to switch to Postgres (schema auto-migrates on first run).
# DATABASE_URL=postgres://user:pass@localhost:5432/rsspool

# Where the SQLite db lives (when DATABASE_URL is unset)
# RSSPOOL_DB_PATH=./data/rsspool.db

# Obsidian vault to mirror items into (one markdown note per item)
# RSSPOOL_OBSIDIAN_VAULT=./data/vault
# RSSPOOL_OBSIDIAN_DISABLED=1     # set to disable the Obsidian sink entirely

# Override the feeds file (default config/feeds.json)
# RSSPOOL_FEEDS=./config/feeds.json

# NotebookLM export bundle output dir
# RSSPOOL_EXPORT_DIR=./data/export
