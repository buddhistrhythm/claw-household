# Postgres is the primary store (DB主 + Obsidian富镜像).
# DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos

# Optional: run inside a non-public schema (multi-tenant / tests).
# LIFEOS_PG_SCHEMA=public

# Obsidian vault that mirrors entities (one note per entity).
# LIFEOS_OBSIDIAN_VAULT=./data/vault
# LIFEOS_OBSIDIAN_DISABLED=1
