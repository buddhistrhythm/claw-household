# Postgres is the primary store (DB主 + Obsidian富镜像).
# DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos

# Optional: run inside a non-public schema (multi-tenant / tests).
# LIFEOS_PG_SCHEMA=public

# Obsidian vault that mirrors entities (one note per entity).
# LIFEOS_OBSIDIAN_VAULT=./data/vault
# LIFEOS_OBSIDIAN_DISABLED=1

# Encryption for finance sensitive fields (data.enc). Unset = dev "plain:" mode (warns once).
# LIFEOS_SECRET_KEY=change-me-to-a-long-random-string
# LIFEOS_ENCRYPTION_REQUIRED=1   # refuse to store sensitive data as plaintext when key missing

# MCP HTTP daemon (`mcp-http`). Safe defaults: localhost only, no auth.
# LIFEOS_MCP_PORT=8848
# LIFEOS_MCP_HOST=127.0.0.1       # set 0.0.0.0 to expose beyond localhost (then SET A TOKEN)
# LIFEOS_MCP_TOKEN=               # bearer token; required for any non-localhost exposure

# RSS ingest (knowledge_item). RSSHub base for {rsshub:...} feeds in config/feeds.json.
# RSSHUB_BASE=https://rsshub.app
# RSSHUB_ACCESS_KEY=

# Embeddings provider for the semantic layer (default: local, offline, no key).
# LIFEOS_EMBED_PROVIDER=local

# docker compose knobs (see docker-compose.yml).
# INGEST_INTERVAL_SECONDS=3600
# OBSIDIAN_SYNC_SECONDS=1800
