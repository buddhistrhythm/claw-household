# ─── Storage ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use the bundled SQLite store (zero setup).
# Set it to switch to Postgres (schema auto-migrates on first run).
# DATABASE_URL=postgres://user:pass@localhost:5432/knowledge_base

# Where the SQLite db lives (when DATABASE_URL is unset)
# KB_DB_PATH=./data/kb.db

# Obsidian vault to mirror items into (one markdown note per item)
# KB_OBSIDIAN_VAULT=./data/vault
# KB_OBSIDIAN_DISABLED=1     # set to disable the Obsidian sink entirely

# NotebookLM export bundle output dir
# KB_EXPORT_DIR=./data/export

# ─── Connectors ───────────────────────────────────────────────────────────────
# Hacker News: your HN username — favorites are read from the public /favorites page.
# HN_USERNAME=pg

# X.com (Twitter) — needs a paid API bearer token + your numeric user id.
# Without these the connector falls back to fixtures/x_likes.sample.json.
# X_BEARER_TOKEN=
# X_USER_ID=

# 小红书 / Xiaohongshu — no official API; needs a logged-in web cookie.
# Without it the connector falls back to fixtures/xiaohongshu_favorites.sample.json.
# XHS_COOKIE=
